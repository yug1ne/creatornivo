# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sentry (error monitoring — server + client; optional in local dev)
# Create project: https://sentry.io — use the same DSN for both vars below
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Build-time only (Vercel / CI): upload source maps for readable stack traces
# SENTRY_AUTH_TOKEN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""

# Database (PostgreSQL + Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/creatornivo"
# Direct connection for pg_dump backups only (Supabase: not the pooler URL)
# BACKUP_DATABASE_URL="postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres"

# Off-site encrypted backups (GitHub Actions + local scripts/backup)
# BACKUP_AGE_PUBLIC_KEY="age1..."
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME="creatornivo-db-backups"
# BACKUP_RETENTION_DAYS="30"
# RESTORE_DATABASE_URL="postgresql://postgres:password@127.0.0.1:5433/postgres"

# Email (Resend) — password reset + welcome email
# Without RESEND_API_KEY: emails are not sent (dev warns; prod logs emailHash only)
RESEND_API_KEY=""
# Verified sender/domain in Resend; must match your production domain
EMAIL_FROM="Creatornivo <noreply@creatornivo.com>"

# Auth rate limiting (Upstash Redis) — required in production
# Protects login, register, forgot-password (IP + emailHash), reset-password (IP)
# Without Upstash: limits are skipped (dev warns once; production should always configure)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Free-account anti-abuse (Phase 5.2)
# HMAC secret for deleted-account email identity tombstones (openssl rand -hex 32)
# Without it, tombstones are skipped (dev); set in production before launch
ACCOUNT_IDENTITY_HASH_SECRET=""
# HMAC secret for AppSumo lifetime codes (openssl rand -hex 32). Required to redeem.
# APPSUMO_CODE_HASH_SECRET=""
# Optional AppSumo model override. Defaults to gpt-5.6-luna. Never use Terra here.
# OPENAI_MODEL_APPSUMO="gpt-5.6-luna"
# none (default) or low. Do not set medium for AppSumo.
# APPSUMO_REASONING_EFFORT="none"
# open | block_disposable (default) | trusted_only
EMAIL_DOMAIN_POLICY="block_disposable"
# Comma-separated extras (optional). trusted_only uses DEFAULT + this list when set.
# TRUSTED_EMAIL_DOMAINS="gmail.com,outlook.com,proton.me"
# Extra blocked domains (comma-separated), always applied when non-empty
# BLOCKED_EMAIL_DOMAINS=""
# Days after delete before the same identity may re-register (0 disables)
DELETED_ACCOUNT_RE_REGISTER_COOLDOWN_DAYS="90"
# Days free-trial lock is recorded on delete (reserved for future free-quota lock)
DELETED_ACCOUNT_FREE_TRIAL_LOCK_DAYS="365"
# Optional global free generation cap (report-only / future; not enforced yet)
# FREE_DAILY_GLOBAL_GENERATION_LIMIT=""

# Auth.js (NextAuth v5) — обязательно для работы авторизации
# Сгенерировать: openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# Canonical app URL — used for password reset links and Auth.js callbacks
AUTH_URL="http://localhost:3000"

# Для NextAuth v5 также используется NEXTAUTH_URL (опционально, fallback for AUTH_URL)
NEXTAUTH_URL="http://localhost:3000"

# OAuth providers (optional)
# Google sign-in — only enabled when BOTH are set (non-empty).
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client (Web)
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://www.creatornivo.com/api/auth/callback/google
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""

# AI providers
OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""

# Admin access (optional — альтернатива роли admin в БД)
# ADMIN_EMAILS="admin@example.com,owner@example.com"

# Paddle (Pro subscription — preferred)
# Sandbox: https://sandbox-vendors.paddle.com
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN="test_..."
NEXT_PUBLIC_PADDLE_ENVIRONMENT="sandbox"
PADDLE_API_KEY="pdl_sdbx_apikey_..."
PADDLE_WEBHOOK_SECRET="pdl_ntfset_..."
# Price IDs from Paddle Dashboard → Catalog → Pro
PADDLE_PRO_PRICE_ID="pri_..."
# Early Access price ($4.9/mo) for first 50 users
PADDLE_EARLY_ACCESS_PRICE_ID="pri_..."

# Stripe (legacy fallback — optional if Paddle is configured)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Freemius (Phase 1: config + schema foundation only — no public checkout yet)
# Dashboard product/plan/pricing IDs (placeholders only in this file)
FREEMIUS_PRODUCT_ID=""
FREEMIUS_PRO_PLAN_ID=""
FREEMIUS_PRO_PRICING_ID=""
# Optional annual pricing id when distinct from monthly
# FREEMIUS_PRO_ANNUAL_PRICING_ID=""
FREEMIUS_FOUNDING_COUPON_CODE=""
FREEMIUS_PUBLIC_KEY=""
# Server-only secrets — never NEXT_PUBLIC_*
FREEMIUS_SECRET_KEY=""
FREEMIUS_API_BEARER_TOKEN=""
# Extra gate on webhook URL (e.g. ?token=...) in addition to x-signature HMAC
FREEMIUS_WEBHOOK_SECRET_TOKEN=""
# Public self-serve checkout kill-switch (must be exactly "true" to enable later)
PUBLIC_CHECKOUT_ENABLED="false"
# Phase 4: restricted checkout testing (keep false in production except during allowlisted tests)
# When true, only emails in FREEMIUS_RESTRICTED_CHECKOUT_EMAILS may call POST /api/freemius/checkout
# (and optionally admins when FREEMIUS_RESTRICTED_CHECKOUT_ADMIN_ONLY=true). Public UI stays off.
FREEMIUS_RESTRICTED_CHECKOUT_ENABLED="false"
# Comma-separated allowlisted emails for restricted checkout (lowercase recommended)
FREEMIUS_RESTRICTED_CHECKOUT_EMAILS=""
# Optional: when true, users who are admins may use restricted checkout without email list entry
FREEMIUS_RESTRICTED_CHECKOUT_ADMIN_ONLY="false"
# Hosted Freemius customer portal / users dashboard (no secrets)
# FREEMIUS_CUSTOMER_PORTAL_URL="https://users.freemius.com/"
# Optional annual pricing id when distinct from monthly FREEMIUS_PRO_PRICING_ID
# FREEMIUS_PRO_ANNUAL_PRICING_ID=""
# Optional checkout origin override (default https://checkout.freemius.com)
# FREEMIUS_CHECKOUT_BASE_URL="https://checkout.freemius.com"
STRIPE_PRO_PRICE_ID="price_..."
STRIPE_EARLY_ACCESS_PRICE_ID="price_..."